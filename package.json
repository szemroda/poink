{
  "name": "poink-cli",
  "version": "0.6.0",
  "description": "Local document knowledge base with semantic search, enrichment, and MCP support.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szemroda/poink.git"
  },
  "bugs": {
    "url": "https://github.com/szemroda/poink/issues"
  },
  "homepage": "https://github.com/szemroda/poink#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "poink": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');const path=require('node:path');const target=path.resolve('dist');if(path.dirname(target)!==process.cwd()||path.basename(target)!=='dist')throw new Error('Refusing to clean unexpected path: '+target);fs.rmSync(target,{recursive:true,force:true});\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "effect-tsgo patch && tsc --noEmit",
    "prepare": "(husky || true) && effect-tsgo patch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.50",
    "@ai-sdk/google": "^4.0.65",
    "@ai-sdk/openai": "^4.0.62",
    "@ai-sdk/provider": "^4.0.11",
    "@inquirer/prompts": "^8.7.2",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "ai": "^7.0.94",
    "ai-sdk-provider-codex-cli": "^2.1.2",
    "commander": "^15.0.0",
    "dedent": "^1.7.2",
    "dotenv": "^17.4.2",
    "effect": "^3.22.2",
    "file-type": "^22.0.2",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.2",
    "mdast-util-to-string": "^4.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "picomatch": "^4.0.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.44.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "@types/yauzl": "^3.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "secretlint": "^13.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "lint-staged": {
    "*": "secretlint"
  }
}
